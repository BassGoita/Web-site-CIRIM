# .gitignore
# Fichiers et dossiers que Git ne doit pas suivre :
# environnement virtuel Python, fichiers temporaires,
# et configuration de l'éditeur (PyCharm).

# Environnement virtuel Python
.venv/
venv/
env/

# Fichiers Python compilés
__pycache__/
*.pyc

# Configuration de l'éditeur PyCharm
.idea/

# Fichiers système
.DS_Store

# Site statique généré par freeze.py (régénéré automatiquement par
# GitHub Actions à chaque mise en ligne, inutile de le committer)
build/
